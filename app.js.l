
const groups=[
['ADMINISTRAÇÃO',[['[CR]','Criador'],['[SB-CR]','Sub criador'],['[ADM]','Administrador']]],
['ALTO COMANDO',[['[CMD]','Comandante'],['[SCMD]','Sub Comandante']]],
['LÍDERES MILITARES',[['[SPR-M]','Supremacia Militar'],['[MAR]','Marechal']]],
['OFICIAIS GENERAIS',[['[GEN-EX]','General de Exército'],['[GEN-D]','General de Divisão'],['[GEN-B]','General de Brigada']]],
['OFICIAIS SUPERIORES',[['[COL]','Coronel'],['[TEN-COL]','Tenente-Coronel'],['[MAJ]','Major']]],
['OFICIAIS INTERMEDIÁRIOS',[['[CAP]','Capitão']]],
['OFICIAIS SUBALTERNOS',[['[1º TEN]','Primeiro Tenente'],['[2º TEN]','Segundo Tenente'],['[ASP]','Aspirante a Oficial']]],
['GRADUADOS',[['[ST]','Sub Tenente'],['[1º SGT]','Primeiro Sargento'],['[2º SGT]','Segundo Sargento'],['[3º SGT]','Terceiro Sargento']]],
['PRAÇAS',[['[CB]','Cabo'],['[SLD]','Soldado'],['[REC]','Recruta']]]
];
const times=[['Recruta',3],['Soldado',6],['Cabo',12],['3º Sargento',15],['2º Sargento',17],['1º Sargento',20],['Sub Tenente',25],['Cadete',30],['Aspirante a Oficial',35],['2º Tenente',40],['1º Tenente',45],['Capitão',50],['Major',55],['Tenente-Coronel',60],['Coronel',65],['General de Brigada',70],['General de Divisão',75],['General de Exército',80],['Marechal',85],['Supremacia Militar',90],['Sub Comandante',100],['Comandante',110]];
let member=null, started=Date.now();
const $=id=>document.getElementById(id);
function toast(t){$('toast').textContent=t;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2200)}
function page(p){document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('selected',n.dataset.page===p));$('login').classList.add('hidden');$('home').classList.add('hidden');$('inner').classList.add('hidden');$('crumb').textContent=labels[p][0];if(p==='home'){(member?$('home'):$('login')).classList.remove('hidden')}else{$('inner').classList.remove('hidden');render(p)}$('sidebar').classList.remove('open')}
const labels={home:['Página inicial'],cdp:['Capacitação (CDP)'],hierarquia:['Hierarquia'],divisoes:['Divisões'],historico:['Histórico militar'],ranking:['Rankings'],loja:['Loja'],titulos:['Títulos']};
function render(p){$('title').textContent=labels[p][0];$('desc').textContent=descriptions[p];let b=$('body');
if(p==='hierarquia'){b.innerHTML=groups.map(g=>`<div class="rank-group"><h3>${g[0]}</h3><div class="rank-list">${g[1].map(x=>`<div class="rank-row"><b>${x[0]} ${x[1]}</b><small>Patente</small></div>`).join('')}</div></div>`).join('')}
else if(p==='cdp'){b.innerHTML=`<div class="content-panel"><div class="tag">CAPACITAÇÃO DE PATENTE</div><h2 style="font:700 21px 'Barlow Condensed';margin:0 0 8px">Tempo mínimo por patente</h2><p>O prazo começa quando a patente é atribuída. Cumprir o tempo mínimo torna o militar apto para avaliação, mas não concede promoção automática.</p><div class="table-scroll"><table><thead><tr><th>Patente</th><th>Tempo mínimo</th></tr></thead><tbody>${times.map(x=>`<tr><td>${x[0]}</td><td>${x[1]} horas</td></tr>`).join('')}</tbody></table></div></div>`}
else if(p==='ranking'){b.innerHTML=`<div class="cards"><div class="metric"><small>Mais promoções concedidas</small><strong>—</strong><span>Aguardando banco de dados</span></div><div class="metric"><small>Militar mais promovido</small><strong>—</strong><span>Aguardando banco de dados</span></div><div class="metric"><small>Mais treinamentos</small><strong>—</strong><span>Aguardando banco de dados</span></div><div class="metric"><small>Militares ativos</small><strong>—</strong><span>Aguardando banco de dados</span></div></div><div class="content-panel"><h2 style="font:700 20px 'Barlow Condensed'">Rankings do EB DO TG</h2><p>Os resultados reais serão calculados a partir dos registros de promoção e treinamento depois da conexão com o banco de dados.</p></div>`}
else{b.innerHTML=`<div class="content-panel"><div class="tag">ÁREA DO SISTEMA</div><h2 style="font:700 21px 'Barlow Condensed';margin:0">${labels[p][0]}</h2><p>${p==='historico'?'As promoções, rebaixamentos e treinamentos registrados aparecerão aqui.':p==='divisoes'?'Área preparada para cadastrar divisões e unidades militares.':p==='loja'?'Área preparada para produtos, serviços e resgates autorizados.':'Área preparada para títulos e condecorações dos militares.'}</p><p>Esta função será ativada na etapa de integração com o banco de dados.</p></div>`}}
const descriptions={cdp:'Consulte o período mínimo necessário para estar apto à próxima avaliação.',hierarquia:'Consulte a estrutura de patentes do Exército.',divisoes:'Consulte as divisões e unidades do EB DO TG.',historico:'Acompanhe as movimentações da carreira militar.',ranking:'Veja os destaques de promoções e treinamentos.',loja:'Acesse a loja oficial do EB DO TG.',titulos:'Consulte títulos e condecorações.'};
document.querySelectorAll('.nav').forEach(n=>n.onclick=()=>page(n.dataset.page));document.querySelectorAll('[data-go]').forEach(n=>n.onclick=()=>page(n.dataset.go));
$('enter').onclick=()=>{let n=$('roblox').value.trim();if(!n){toast('Digite seu usuário Roblox.');return}member=n;started=Date.now();$('userName').textContent=n;$('userRank').textContent='[REC] Recruta';$('avatar').textContent=n[0].toUpperCase();$('welcome').textContent=n;$('personName').textContent=n;$('personUser').textContent=n;$('personAvatar').textContent=n[0].toUpperCase();page('home');toast('Demonstração iniciada!')};
$('copy').onclick=async()=>{try{await navigator.clipboard.writeText($('code').value);toast('Código copiado')}catch(e){toast('Copie o código manualmente')}};
$('open').onclick=()=>$('sidebar').classList.add('open');$('close').onclick=()=>$('sidebar').classList.remove('open');$('logout').onclick=()=>{member=null;$('userName').textContent='Visitante';$('userRank').textContent='Não verificado';page('home')};
setInterval(()=>{if(member){let m=Math.floor((Date.now()-started)/60000);$('elapsed').textContent=Math.floor(m/60)+'h '+String(m%60).padStart(2,'0')+'min'}},10000);page('home');
